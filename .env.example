# 이 파일을 .env 로 복사해서 고쳐 쓰세요.  (cp .env.example .env)
# 비워 두거나 지운 항목은 기본값을 사용합니다.

# ── 기본 ──────────────────────────────────────────
# 서버 포트와 주소 (같은 컴퓨터에서만 쓰려면 HOST=127.0.0.1)
PORT=7777
HOST=0.0.0.0
SERVER_NAME=어둠의 전설 개인 서버
MOTD=던모르 마을에 오신 것을 환영합니다! 도움말은 H 키를 누르세요.

# ── 관리자 ────────────────────────────────────────
# 웹 관리자 페이지(/admin) 비밀번호. 비워 두면 처음 실행할 때 자동으로 만들어
# data/admin-password.txt 에 저장하고 콘솔에 보여 줍니다.
ADMIN_PASSWORD=
# 접속하면 자동으로 관리자 권한을 받는 캐릭터 이름 (쉼표로 구분)
ADMIN_CHARACTERS=
# 서버의 첫 번째 캐릭터에게 관리자 권한을 줄지 (true/false)
FIRST_CHARACTER_ADMIN=true

# ── 가입 제한 ("내 서버"를 나만/지인만 쓰기) ───────────
# open: 누구나 캐릭터 생성 / invite: 초대 코드가 있어야 생성 / closed: 생성 불가
REGISTRATION=open
INVITE_CODE=

# ── 배율과 성장 ────────────────────────────────────
EXP_RATE=1
GOLD_RATE=1
DROP_RATE=1
MAX_LEVEL=99
STAT_CAP=255
STAT_POINTS_PER_LEVEL=2
# 새 캐릭터의 시작 레벨
START_LEVEL=1
# 직업을 고를 수 있는 레벨
CLASS_LEVEL=5
# 죽었을 때 현재 레벨 경험치 손실 비율 (0 = 손실 없음, 0.05 = 5%)
DEATH_EXP_PENALTY=0

# ── 운영 ──────────────────────────────────────────
DATA_DIR=data
AUTOSAVE_SECONDS=30
MAX_PLAYERS=200
MAX_CONNECTIONS_PER_IP=8
# nginx 같은 리버스 프록시 뒤에서 실행할 때 true (실제 접속 IP 를 X-Forwarded-For 에서 읽음)
TRUST_PROXY=false
LOG_LEVEL=info
